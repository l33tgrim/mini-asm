# Copy to .env.local for local use, or to .env for docker compose, and fill in.
# The app refuses to serve in production (and in the container) without credentials.
ASM_USERNAME=
ASM_PASSWORD=

# Only on a trusted local machine: run without sign-in.
# ASM_AUTH_DISABLED=true

# Optional: AI-assisted name suggestions and scenario drafting.
# ANTHROPIC_API_KEY=
