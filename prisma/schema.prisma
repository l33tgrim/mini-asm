generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Scan {
  id             String    @id @default(cuid())
  target         String
  status         String    @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED, TIMED_OUT, INTERRUPTED
  type           String    @default("MANUAL") // MANUAL, SCHEDULED
  currentIndex   Int       @default(0)
  totalIps       Int       @default(0)
  ipList         String?   // JSON string of all IPs to scan
  hostMap        String?   // JSON map of IP -> hostnames, kept so a resumed scan has the same context
  portSpec       String?   // TCP ports as typed, e.g. "default, 8000-8100". Null means the default list
  udp            Boolean   @default(true) // Run the UDP service probes as well
  pathNote       String?   // Ports skipped because the network path answers them for any address
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  findings       Finding[]
}

model Finding {
  id            String   @id @default(cuid())
  ip            String
  port          Int
  protocol      String   @default("tcp") // tcp or udp
  service       String?
  version       String?
  banner        String?
  severity      String   // LOW, MEDIUM, HIGH, CRITICAL
  description   String?
  vulnerability String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Forensic and Remediation Fields
  remediation      String?
  forensics        String?
  upstreamVersion  String?
  confidence       Int?      @default(100)
  discoveryMethod  String?   @default("ACTIVE_PROBE")
  domains          String?   // Comma separated list of domains
  techStack        String?   // Detected technologies
  closedAt         DateTime? // Set when a later scan of the host found the port no longer answering

  // Many-to-many relationship with scans
  scans         Scan[]

  @@unique([ip, port, protocol], name: "ip_port_protocol")
}

model Schedule {
  id        String   @id @default(cuid())
  target    String
  frequency String   // DAILY, WEEKLY, MONTHLY
  nextRun   DateTime
  active    Boolean  @default(true)
  lastRun   DateTime?
  createdAt DateTime @default(now())
}

// ============================================================
// Breach & Attack Simulation (BAS) engine
// ============================================================

// An authorized testing engagement. Nothing active runs without one.
model Engagement {
  id           String   @id @default(cuid())
  name         String
  description  String?
  // DRAFT -> AUTHORIZED -> ACTIVE -> COMPLETED | REVOKED
  status       String   @default("DRAFT")
  // SAFE = non-destructive validation only.
  // ACTIVE = still non-destructive, but runs reach/command/data proofs. Gated.
  mode         String   @default("SAFE")
  authorizedBy String?
  authorizedAt DateTime?
  revokedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  scope     ScopeEntry[]
  runs      ScenarioRun[]
  auditLogs AuditLog[]
}

// A single asset in an engagement's scope. Must be ownership-verified
// before any active scenario may touch it.
model ScopeEntry {
  id           String     @id @default(cuid())
  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  value        String // domain, ip, or cidr
  kind         String // DOMAIN, IP, CIDR
  verified     Boolean    @default(false)
  verifyToken  String?
  verifyMethod String? // DNS_TXT, WELL_KNOWN
  verifiedAt   DateTime?
  createdAt    DateTime   @default(now())

  @@unique([engagementId, value])
}

// One execution of a scenario (or playbook step) against a target.
model ScenarioRun {
  id           String     @id @default(cuid())
  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  scenarioId   String
  scenarioName String
  playbookId   String?
  target       String
  mode         String     @default("SAFE")
  // PENDING, RUNNING, COMPLETED, FAILED, BLOCKED
  status       String     @default("PENDING")
  summary      String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime   @default(now())

  results ScenarioResult[]
}

// A single finding / proof produced by a scenario run.
model ScenarioResult {
  id             String      @id @default(cuid())
  runId          String
  run            ScenarioRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  title          String
  // INFO, LOW, MEDIUM, HIGH, CRITICAL
  severity       String      @default("INFO")
  // SECURE (control held), VULNERABLE, PROVEN (proof obtained), INFO, ERROR
  outcome        String      @default("INFO")
  attckTactic    String?
  attckTechnique String?
  target         String?
  // Non-destructive evidence: request/response snippet, command output, counts.
  evidence       String?
  remediation    String?
  createdAt      DateTime    @default(now())
}

// Append-only audit trail. Every gate decision and active action lands here.
model AuditLog {
  id           String      @id @default(cuid())
  engagementId String?
  engagement   Engagement? @relation(fields: [engagementId], references: [id], onDelete: SetNull)
  action       String
  target       String?
  detail       String?
  actor        String      @default("system")
  createdAt    DateTime    @default(now())
}

// A user-defined threat scenario: an ordered, parameterized composition of
// scenarios that emulates a specific threat. Modular and editable without code.
model CustomPlaybook {
  id           String         @id @default(cuid())
  name         String
  description  String?
  threat       String? // threat profile / actor emulated, e.g. "Ransomware affiliate"
  attckTactics String? // comma-separated
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  steps        PlaybookStep[]
}

model PlaybookStep {
  id         String         @id @default(cuid())
  playbookId String
  playbook   CustomPlaybook @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  scenarioId String
  order      Int            @default(0)
  params     String? // JSON params passed to the scenario for this step
  createdAt  DateTime       @default(now())
}
