{
  "name": "mini-asm-tool",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "DATABASE_URL=${DATABASE_URL:-file:./dev.db} prisma migrate deploy",
    "postinstall": "DATABASE_URL=${DATABASE_URL:-file:./dev.db} prisma generate",
    "miniasm": "tsx bin/miniasm.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "axios": "^1.13.4",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^0.563.0",
    "next": "16.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.30",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "5.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  }
}
